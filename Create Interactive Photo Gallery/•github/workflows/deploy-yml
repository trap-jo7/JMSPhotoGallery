name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: Create Interactive Photo Gallery
    steps:
      - uses: actions/checkout@v4

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Add missing settings file
        run: |
          mkdir -p .figma/make
          [ -f .figma/make/site.json ] || echo '{"title": "IMS Photo Gallery"}' > .figma/make/site.json

      - run: pnpm install --frozen-lockfile

      - run: pnpm exec vite build
        env:
          FIGMA_PUBLIC_URL: /${{ github.event.repository.name }}

      - run: cp dist/index.html dist/404.html

      - uses: actions/upload-pages-artifact@v3
        with:
          path: Create Interactive Photo Gallery/dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
